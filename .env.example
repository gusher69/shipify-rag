# =============================================================================
# Shipify AI Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env itself.
#
# Every variable below was verified against its actual consumer in the
# codebase during the 2026-08-01 configuration audit — nothing here is
# guessed or aspirational unless explicitly marked "not yet implemented."
#
# New machine? See .env.setup.example for the minimal subset you must fill
# in before the Admin app will start at all — everything else here has a
# safe default or is genuinely optional.
#
# Legend used in comments below:
#   [REQUIRED]   the app will not behave correctly without a real value
#   [OPTIONAL]   has a safe default; only needed for a specific feature
#   [GENERATED]  create it yourself with the one-line command shown — never
#                a value you "make up" or reuse from anywhere else
#   [SETTINGS]   can also be edited from Admin -> Settings after first boot
#                (see docs/API.md / admin/templates/settings.html)
# =============================================================================


# =============================================================================
# 1. REQUIRED — Application (OpenAI: LLM + embeddings)
# =============================================================================
# [REQUIRED] [SETTINGS] The only LLM/embedding provider implemented today —
# used for chat completion (gpt-4o) and RAG embeddings. No default; the app
# cannot generate a reply or embed a document without this.
OPENAI_API_KEY=

# [OPTIONAL] [SETTINGS] Defaults to gpt-4o if unset — safe to leave blank for
# a first run. See services/llm_service.py.
OPENAI_CHAT_MODEL=gpt-4o

# [OPTIONAL] [SETTINGS] Defaults to text-embedding-3-large (3072 dimensions)
# if unset. This is the ONLY canonical embedding-model variable — config.py
# always prefers it. MUST match knowledge_chunks.embedding's actual column
# width (migrations/019_openai_embedding_dimension.sql) — changing this
# requires re-embedding all existing content. Never edit casually; see
# services/embedding_service.py::report_and_validate_embedding_configuration()
# for the startup check that catches a mismatch before it causes silent data
# corruption.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# [OPTIONAL] "openai" (default, active) is the only implemented provider;
# "local" is a non-default, no-API-key-needed fallback (sentence-transformers,
# see services/embedding_service.py) — never selected automatically.
EMBEDDING_PROVIDER=openai

# [OPTIONAL] Truncates the model's native embedding output dimension (e.g. to
# 1024). Leave unset to use the model's native dimension (3072 for
# text-embedding-3-large). Changing this requires re-applying
# migrations/019_openai_embedding_dimension.sql with the matching VECTOR(n)
# width.
# OPENAI_EMBEDDING_DIMENSIONS=

# [OPTIONAL] Defaults to 64. How many texts are sent to the embeddings API per
# batch call.
EMBEDDING_BATCH_SIZE=64


# =============================================================================
# 2. REQUIRED — Database (Supabase Postgres + pgvector + Storage)
# =============================================================================
# [REQUIRED] [SETTINGS] https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=

# [REQUIRED] [SETTINGS] The SERVICE-ROLE key (not the anon key) — required for
# server-side writes across nearly every module (see admin/routes.py::get_sb()
# and its many callers).
SUPABASE_SERVICE_KEY=

# [REQUIRED] Direct Postgres connection string (transaction pooler, port
# 6543) — used only by services/embedding_service.py's
# get_expected_db_vector_dimension() to read knowledge_chunks.embedding's
# real column width straight from pg_attribute. Independent of the
# supabase-py client above; needs the psycopg2-binary package (see
# requirements.txt).
# https://supabase.com/dashboard/project/<project>/settings/database
SUPABASE_DB_URL=

# [OPTIONAL] Defaults to "knowledge-files". Only relevant when
# STORAGE_PROVIDER=supabase (the default) — see storage/factory.py.
SUPABASE_STORAGE_BUCKET=knowledge-files


# =============================================================================
# 3. REQUIRED — Authentication & Secrets
# =============================================================================
# [OPTIONAL] Defaults to "admin" — safe to leave as-is for local dev.
ADMIN_USERNAME=admin

# [REQUIRED] [SETTINGS] No safe default — config.py falls back to the literal
# string "changeme" if unset, which must never be relied on past local dev.
# admin/routes.py::auth() checks this on every login.
ADMIN_PASSWORD=

# [REQUIRED] [GENERATED] Signs the admin session cookie. config.py falls back
# to a hardcoded, publicly-visible default ("shipify-secret-change-me") if
# unset — do not rely on that past local dev.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# [REQUIRED] [GENERATED] Fernet master key for the Credential Store
# (services/credential_store.py) — required before any encrypted credential
# can be created/rotated/resolved. Legacy env-var-based Business Action
# secrets (see EXAMPLE_ERP_SECRET_CODE example below) keep working without it.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=


# =============================================================================
# 4. REQUIRED — LINE Messaging API (only if running the LINE webhook)
# =============================================================================
# Not needed to run the Admin app alone — only required for
# `uvicorn line_bot.webhook:app` (line_bot/webhook.py) to actually receive/
# send LINE messages.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=

# [OPTIONAL] Only needed for Smart Handoff (escalating a low-confidence/
# upset conversation to a human via LINE Notify). See
# line_bot/webhook.py::send_line_notify().
LINE_NOTIFY_TOKEN=

# [OPTIONAL] P2.1A conversation-intelligence shadow-observability sample
# separation ONLY — not auth, not a feature flag, never read for
# routing. Comma-separated LINE user ids (the webhook's own
# HMAC-verified sender id) for owner/tester accounts, so their traffic
# is tagged sample_source=OWNER_TEST and never inflates the >= 200
# REAL_LINE shadow-parity cutover sample (see
# services/conversation_intelligence_telemetry.py). The id itself is
# never persisted — only the OWNER_TEST label is. Leave empty (default)
# to treat every LINE sender as REAL_LINE, unchanged.
OWNER_TEST_LINE_USER_IDS=


# =============================================================================
# 5. OPTIONAL — Google Drive Sync (nightly knowledge ingestion)
# =============================================================================
# Only needed if you use the Google Drive -> Knowledge Base sync job
# (ingestion/gdrive_sync.py) or the Google Drive storage backend
# (storage/factory.py). Requires a Google Service Account JSON key file —
# never commit that file.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# [OPTIONAL] Used by the newer storage-abstraction Google Drive provider
# (storage/factory.py) — defaults to GOOGLE_DRIVE_FOLDER_ID /
# GOOGLE_SERVICE_ACCOUNT_JSON above if unset. Only set these separately if
# the storage-backend folder/credentials genuinely differ from the sync
# job's.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_APPLICATION_CREDENTIALS=


# =============================================================================
# 6. OPTIONAL — Storage Backend
# =============================================================================
# [OPTIONAL] Defaults to "local" in code. One of: local | supabase |
# google_drive | s3 | minio. See storage/factory.py — only this variable
# (and the matching provider's own credentials below) should change when
# migrating storage backends.
#
# This variable controls Knowledge/File Library file storage ONLY (audited
# 2026-08-18: every get_storage_service() caller in the codebase is
# upload/delete/download/health-check for knowledge files and their
# Excel-embedded image attachments — nothing else in the platform reads
# it). Supabase Postgres/pgvector (chunks, embeddings, metadata) is a
# SEPARATE, always-on dependency regardless of this setting.
#
# "local" (the customer-server deployment default) — original source
# files and linked/embedded images live under LOCAL_STORAGE_ROOT on the
# server's own persistent disk (bind-mounted outside the container so
# they survive rebuilds — see docker-compose.override.yml). This is the
# intended architecture when Supabase is a temporary hosted dependency
# slated for a later self-hosted migration onto the same server: the
# original files should already live on that server, not in a cloud
# bucket that would need its own separate migration.
#
# "supabase" — original files live in Supabase Storage instead (useful
# when the server itself has no durable disk, e.g. an ephemeral
# container host with no persistent volume support).
STORAGE_PROVIDER=local

# [OPTIONAL] Defaults to "delete". One of: delete | archive.
# STORAGE_DELETE_MODE=delete

# [OPTIONAL] Defaults to "knowledge" — only used by the "local" provider. Do
# not change this on an existing deployment without also migrating files
# already on disk.
# LOCAL_STORAGE_ROOT=knowledge

# ---- S3 / MinIO (only needed when STORAGE_PROVIDER=s3; MinIO is
#      S3-compatible — set S3_ENDPOINT to the MinIO endpoint URL) ----------
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=


# =============================================================================
# 7. OPTIONAL — AI / RAG Runtime Tuning
# =============================================================================
# Every value below has a working default — only touch these if you know you
# need to. Most day-to-day retrieval tuning (search strategy, top-k, ranking
# weights, reranker) lives in the Admin UI's Settings -> Retrieval Settings
# card instead (DB-backed, live reload, no restart — see
# services/retrieval_settings.py). The RAG_* variables below are that
# subsystem's file-level DEFAULT, consulted only before any DB override row
# exists; editing them by hand is rarely necessary.

# [OPTIONAL] Confidence below this always routes to Smart Handoff instead of
# an auto-reply. Defaults to 0.75.
CONFIDENCE_THRESHOLD=0.75

# [TEMPORARY — Production Integration Sprint, 2026-08-02] Defaults to true
# (Local Production Pipeline Verification phase) — line_bot/webhook.py
# routes real LINE OA traffic through the modern Decision Engine
# (services/decision_engine.py). Set to false only to fall back to the
# temporary legacy adapter. The legacy adapter and this flag are both
# removed once LINE OA UAT passes.
DECISION_ENGINE_LIVE_ROUTING=true

# [OPTIONAL] How long (seconds) a pending confirmation for a COMMAND-type
# Business Action (e.g. SendLineNotiCS) stays valid before it expires and
# must be re-requested. Defaults to 300 (5 minutes). See
# services/pending_confirmation_service.py.
# PENDING_CONFIRMATION_TIMEOUT_SECONDS=300

# [OPTIONAL] How many raw vector-search candidates are pulled before hybrid
# reranking. Defaults to 30. See rag/searcher.py.
# RAG_RAW_CANDIDATE_COUNT=30

# [OPTIONAL] Widened context size for broad "summarize/overview" questions.
# Defaults to 12. See rag/searcher.py::is_broad_summary_query.
# RAG_SUMMARY_TOP_K=12

# [OPTIONAL] "strict" (default) forbids the LLM from adding unsupported
# outside knowledge. See services/prompt_builder.py.
# RAG_GROUNDING_MODE=strict

# [OPTIONAL] Enables an LLM query-rewrite pass before retrieval (costs a real
# LLM call per new/uncached query). Defaults to false. See
# rag/query_expansion.py.
# RAG_QUERY_REWRITE_ENABLED=false

# [OPTIONAL] Vision/OCR ingestion depth: "disabled" (native text only) |
# "basic" (default — native + free local OCR fallback) | "advanced" (adds
# real per-image OpenAI Vision cost for pages that need it). Defaults to
# "basic" so upgrading never silently starts spending money.
# VISION_OCR_ANALYSIS_PROFILE=basic

# [OPTIONAL] Base URL used to build absolute attachment/download links shown
# in the Admin UI and in customer-facing responses. Defaults to
# http://localhost:8001/admin/attachments.
# ATTACHMENT_BASE_URL=https://your-admin-host

# [OPTIONAL] Single-tenant deployments never need to set this. Defaults to
# "default". See services/credential_store.py.
# DEFAULT_TENANT_ID=default

# ---- Feature toggles (all default to "true"; set to "false" to disable) ---
# Each gates one AI ingestion sub-pipeline; disabling is a cost/behavior
# trade-off, not a bug workaround. Previously undocumented — added here for
# visibility (2026-08-01 audit).
# ENABLE_SMART_ALT_QUESTIONS=true      # services/ai_auto_setup_service.py / ingestion/smart_enrichment.py
# ENABLE_KNOWLEDGE_ANALYZER_LLM=true   # services/knowledge_analyzer.py
# ENABLE_KNOWLEDGE_GRAPH=true          # services/knowledge_graph_service.py

# ---- Admin sidebar navigation visibility (routes/APIs stay fully
#      functional either way — this only hides a menu item, e.g. during a
#      customer demo phase focused on Knowledge Base + AI Playground only) --
SHOW_AI_EVALUATION=true
SHOW_PRODUCTION_VALIDATION=true
SHOW_BUSINESS_ACTION_CENTER=true

# [OPTIONAL] Shows advanced/unfinished admin tools (see CLAUDE.md). Defaults
# to false. Editable live from Admin -> Settings -> Developer Settings — no
# restart needed.
# DEVELOPER_MODE=false

# ---- Business Action provider overrides (advanced — Phase 7 future ERP
#      connector work; every category defaults to "mock" today) -----------
# One var per category: CUSTOMER, ORDER, TRACKING, FINANCE, PRODUCT. See
# services/business_action_providers.py. Not needed for normal use.
# BUSINESS_ACTION_PROVIDER_CUSTOMER=mock
# BUSINESS_ACTION_PROVIDER_ORDER=mock
# BUSINESS_ACTION_PROVIDER_TRACKING=mock
# BUSINESS_ACTION_PROVIDER_FINANCE=mock
# BUSINESS_ACTION_PROVIDER_PRODUCT=mock

# ---- Business Action Center — legacy secret_configuration mechanism ------
# A Business Action's secret parameter can reference a plain environment
# variable by name instead of the Credential Store above (see
# services/business_action_registry.py::resolve_secret_ref). The variable
# NAME is whatever the admin configured for that one Business Action — the
# line below is only an illustrative example, not a fixed requirement. New
# Business Actions should prefer the Credential Store instead. Never store a
# real secret value in source control, migrations, seeds, or documentation.
# EXAMPLE_ERP_SECRET_CODE=

# =============================================================================
# See LEGACY_ENV.md for every variable that used to live in this file and
# was removed during the 2026-08-01 final configuration cleanup — including
# the never-implemented alternate-LLM-provider variables (Azure OpenAI, Groq,
# OpenRouter), the legacy OPENAI_EMBED_MODEL alias, and every confirmed-dead
# RAG_*/GOOGLE_DRIVE_*/AUTO_MODE/SHOW_* variable. Nothing below this line is
# hidden — it has simply moved, with the reason it moved documented there.
# =============================================================================
