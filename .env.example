# Copy this file to .env and fill in real values. Never commit .env itself.

# ── OpenAI (primary LLM + embedding provider) ─────────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Embedding provider — single source of truth for both document ingestion
# and query embedding (services/embedding_service.py). "openai" is the
# active default; "local" is an explicit, non-default fallback (requires
# no OPENAI_API_KEY, but is never chosen automatically).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional: truncate the model's native output dimension (e.g. 1024).
# Leave unset to use the model's native dimension (3072 for
# text-embedding-3-large). If you change this, migrations/019_openai_embedding_dimension.sql
# must be re-applied with the matching VECTOR(n) width.
# OPENAI_EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64

# ── Supabase (Postgres + pgvector + Storage) ──────────────────────────────
# https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx
SUPABASE_STORAGE_BUCKET=knowledge-files

# Supabase DB (Transaction pooler port 6543)
# https://supabase.com/dashboard/project/<project>/settings/database
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── LINE Messaging API / LINE Notify ──────────────────────────────────────
LINE_CHANNEL_SECRET=xxx
LINE_CHANNEL_TOKEN=xxx
LINE_NOTIFY_TOKEN=xxx

# ── Google Drive Sync (nightly knowledge ingestion) ───────────────────────
GOOGLE_DRIVE_FOLDER_ID=xxx
GOOGLE_DRIVE_ROOT_FOLDER_ID=xxx
GOOGLE_DRIVE_ATTACHMENTS_FOLDER_ID=xxx
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ── Optional: alternate LLM providers (multi-provider support) ────────────
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ── Optional: S3-compatible file storage backend ──────────────────────────
# Only needed when STORAGE_PROVIDER=s3 (default is "supabase").
STORAGE_PROVIDER=supabase
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# STORAGE_DELETE_MODE=soft
# LOCAL_STORAGE_ROOT=./local_storage

# ── App / RAG tuning (safe defaults — non-secret) ─────────────────────────
CONFIDENCE_THRESHOLD=0.75
AUTO_MODE=false
DEFAULT_TENANT_ID=default
# RAG_FINAL_TOP_K=
# RAG_RAW_CANDIDATE_COUNT=
# RAG_SUMMARY_TOP_K=
# RAG_VECTOR_WEIGHT=
# RAG_KEYWORD_WEIGHT=
# RAG_HEADING_WEIGHT=
# RAG_GROUNDING_MODE=
# RAG_QUERY_REWRITE_ENABLED=true
# VISION_OCR_ANALYSIS_PROFILE=

# ── Admin UI ───────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# SESSION_SECRET is used to sign the admin login session cookie.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: base URL used to build absolute attachment/download links
# shown in the admin UI and in customer-facing responses.
# ATTACHMENT_BASE_URL=https://your-admin-host

# ── Business Action Center — legacy secret_configuration references ───────
# (see services/business_action_registry.py::resolve_secret_ref). A
# Business Action can still reference a plain environment variable for
# its secret — never store the real value in source control, migrations,
# seeds, or documentation. New Business Actions should prefer the
# Credential Store (below) instead.
FASTTRADE_AI_CHAT_SECRET_CODE=

# ── Credential Store — platform master encryption key (Fernet, base64
# urlsafe 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit the real value. Required before any encrypted credential
# can be created/rotated/resolved — legacy secret_configuration
# (environment variable) parameters keep working without it.
CREDENTIAL_ENCRYPTION_KEY=

# ── Admin sidebar navigation feature flags — default true (menu item
# visible). Set to false to temporarily hide a menu item from the
# sidebar (routes/templates/APIs stay fully functional; direct URLs
# still work) — e.g. during a demo phase focused only on Knowledge Base
# + AI Playground. See admin/sidebar_config.py.
SHOW_AI_EVALUATION=true
SHOW_PRODUCTION_VALIDATION=true
SHOW_BUSINESS_ACTION_CENTER=true

# Advanced/unfinished admin tools visibility (see CLAUDE.md).
# DEVELOPER_MODE=false
